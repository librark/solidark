{
  "name": "@librark/solidark",
  "version": "0.1.0",
  "description": "Web Component based constructive solid geometry for JavaScript.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./component": {
      "types": "./lib/component.d.ts",
      "default": "./lib/component.js"
    },
    "./cdn": {
      "types": "./lib/cdn.d.ts",
      "default": "./lib/cdn.js"
    },
    "./elements": {
      "types": "./lib/elements.d.ts",
      "default": "./lib/elements.js"
    },
    "./export": {
      "types": "./lib/export/index.d.ts",
      "default": "./lib/export/index.js"
    },
    "./kernel": {
      "types": "./lib/runtime/kernel/index.d.ts",
      "default": "./lib/runtime/kernel/index.js"
    },
    "./robot": {
      "types": "./lib/robot/index.d.ts",
      "default": "./lib/robot/index.js"
    },
    "./runtime": {
      "types": "./lib/runtime/index.d.ts",
      "default": "./lib/runtime/index.js"
    },
    "./viewer": {
      "types": "./lib/external/viewer/index.d.ts",
      "default": "./lib/external/viewer/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "!lib/**/*.test.js",
    "showcase/**/*.html",
    "showcase/**/*.js",
    "showcase/**/*.css",
    "showcase/README.md",
    "!showcase/**/*.test.js",
    "docs/**/*.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "standard": "XDG_CACHE_HOME=.cache standard",
    "standard:fix": "XDG_CACHE_HOME=.cache standard --fix",
    "showcase": "node showcase/server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='lib/**/*.js' --test-coverage-include='showcase/**/*.js' --test-coverage-exclude='lib/**/*.test.js' --test-coverage-exclude='showcase/**/*.test.js' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100",
    "pack:check": "npm_config_cache=.npm npm pack --dry-run",
    "release:check": "npm run standard && npm run test:coverage && npm run pack:check"
  },
  "keywords": [
    "cad",
    "csg",
    "opencascade",
    "web-components"
  ],
  "unpkg": "./lib/cdn.js",
  "jsdelivr": "./lib/cdn.js",
  "dependencies": {
    "@google/model-viewer": "4.1.0",
    "opencascade.js": "1.1.1",
    "three": "0.172.0"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.5.0",
    "cannon-es": "^0.20.0",
    "standard": "^17.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/librark/solidark.git"
  },
  "bugs": {
    "url": "https://github.com/librark/solidark/issues"
  },
  "homepage": "https://github.com/librark/solidark#readme",
  "license": "MIT"
}
